# Looker SDK Settings
LOOKERSDK_BASE_URL=https://your-looker-instance.cloud.looker.com
LOOKERSDK_CLIENT_ID=your_looker_api_client_id
LOOKERSDK_CLIENT_SECRET=your_looker_api_client_secret

# OAuth 2.0 Server Configuration
OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
OAUTH_ISSUER_URL=https://auth.myfunction.com
ALLOWED_REDIRECT_URIS=https://global.consent.azure-apim.net/redirect/your-app-id,https://app.example.com/callback
